{
  "name": "sonos-cli",
  "version": "0.1.0",
  "description": "Control Sonos speakers in the local network (UPnP/SOAP and local Control API). A Bun port of the SoCo logic.",
  "keywords": [
    "sonos",
    "cli",
    "upnp",
    "soco",
    "bun",
    "smart-speaker"
  ],
  "license": "MIT",
  "author": "Erik May",
  "homepage": "https://github.com/erikmay/sonos-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikmay/sonos-cli.git"
  },
  "bugs": {
    "url": "https://github.com/erikmay/sonos-cli/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "sonos": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/sonos"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
