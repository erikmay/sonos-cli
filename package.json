{
  "name": "sonos-cli",
  "version": "0.1.0",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "bin": {
    "sonos": "./src/cli.ts"
  },
  "description": "Control Sonos speakers in the local network (UPnP/SOAP and local Control API). A Bun port of the SoCo logic.",
  "private": true,
  "scripts": {
    "start": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/sonos"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  }
}
